{
  "name": "k-12-backend-api",
  "version": "1.0.0",
  "description": "Backend API for K-12 tutoring platform with user authentication, courses, challenges, and community features. Deploy to Render for iOS app integration.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t k12-backend .",
    "docker:run": "docker run -p 5000:5000 k12-backend",
    "test:api": "./test-api.sh",
    "deploy": "./deploy.sh",
    "deploy:render": "./deploy-render.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "tutoring",
    "education",
    "api"
  ],
  "author": "NextGenius",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "mongodb": "^5.0.0",
    "mongoose": "^7.0.0",
    "express-validator": "^7.0.0",
    "express-async-handler": "^1.2.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
